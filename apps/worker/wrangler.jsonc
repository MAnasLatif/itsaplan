{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "itsaplan-worker",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "f235a03eb3da7318d97d1b9334e3fb52",
  "observability": { "enabled": true },
  "workers_dev": false,
  // This instance's public values. Secrets are set with `wrangler secret put`.
  "vars": {
    "API_URL": "https://plan.anaslatif.dev/api",
    "APP_URL": "https://plan.anaslatif.dev",
    "EMAIL_FROM": "It's a Plan <noreply@plan.anaslatif.dev>",
    // Cloudflare sets this header at its edge and replaces any value a client sends.
    "CLIENT_IP_HEADER": "cf-connecting-ip",
  },
  // src/cloudflare.ts runs every loop for most of each minute.
  "triggers": { "crons": ["* * * * *"] },
  // An import tick parses source pages and attachments; the default 30 s of CPU per
  // invocation is too little for a busy minute.
  "limits": { "cpu_ms": 300000 },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "60b0bdd2b15b4489bf1fd394941bd353",
      "localConnectionString": "postgres://itsaplan:itsaplan@localhost:5432/itsaplan",
    },
  ],
  "send_email": [{ "name": "EMAIL" }],
}
